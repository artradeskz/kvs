.текст
.глобал _start

_start:
    переместить_имм р8, 1          ; число = 1

цикл:
    ; Выводим число
    переместить раикс, р8
    прибавить_непосредственно раикс, 0x30
    сохранить [буфер], раикс
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, буфер
    переместить_имм рдикс, 1
    вызов_системы
    
    ; Перевод строки
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, nl
    переместить_имм рдикс, 1
    вызов_системы
    
    ; Умножаем на 2
    переместить раикс, р8
    переместить_имм р9, 2
    умножить р9
    переместить р8, раикс
    
    ; Продолжаем пока < 10
    сравнить_с р8, 10
    переход_если_меньше цикл        ; длинный переход вместо короткого
    
    ; exit(0)
    переместить_имм раикс, 60
    переместить_имм рдиай, 0
    вызов_системы

.данные
буфер:
    .байт 0, 0, 0, 0, 0, 0, 0, 0
nl:
    .байт 0x0A