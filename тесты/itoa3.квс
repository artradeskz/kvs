.текст
.глобал _start

_start:
    ; МЕНЯЙ ЧИСЛО:
    переместить_имм раикс, 59321
    
    ; 1-й разряд (единицы): число / 10
    переместить_имм рдикс, 0
    переместить_имм рсикс, 10
    разделить рсикс                  ; rax = 5432, rdx = 1
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра4], рдикс
    
    ; 2-й разряд (десятки): частное / 10
    переместить_имм рдикс, 0
    разделить рсикс                  ; rax = 543, rdx = 2
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра3], рдикс
    
    ; 3-й разряд (сотни)
    переместить_имм рдикс, 0
    разделить рсикс                  ; rax = 54, rdx = 3
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра2], рдикс
    
    ; 4-й разряд (тысячи)
    переместить_имм рдикс, 0
    разделить рсикс                  ; rax = 5, rdx = 4
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра1], рдикс
    
    ; 5-й разряд (десятки тысяч)
    прибавить_непосредственно раикс, 0x30
    сохранить [цифра0], раикс
    
    ; Выводим 5 цифр по одной
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра0
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра1
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра2
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра3
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра4
    переместить_имм рдикс, 1
    вызов_системы
    
    ; Перевод строки
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, nl
    переместить_имм рдикс, 1
    вызов_системы
    
    ; exit(0)
    переместить_имм раикс, 60
    переместить_имм рдиай, 0
    вызов_системы

