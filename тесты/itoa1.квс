.текст
.глобал _start

_start:
    ; Конвертируем 1034
    переместить_имм раикс, 1034
    
    ; 1234 / 10 = 123, остаток 4
    переместить_имм рдикс, 0
    переместить_имм рсикс, 10
    разделить рсикс
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра3], рдикс
    
    ; 123 / 10 = 12, остаток 3
    переместить_имм рдикс, 0
    разделить рсикс
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра2], рдикс
    
    ; 12 / 10 = 1, остаток 2
    переместить_имм рдикс, 0
    разделить рсикс
    прибавить_непосредственно рдикс, 0x30
    сохранить [цифра1], рдикс
    
    ; Частное 1 → последняя цифра
    прибавить_непосредственно раикс, 0x30
    сохранить [цифра0], раикс
    
    ; Выводим 4 цифры по одной
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра0
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра1
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра2
    переместить_имм рдикс, 1
    вызов_системы
    
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, цифра3
    переместить_имм рдикс, 1
    вызов_системы
    
    ; Перевод строки
    переместить_имм раикс, 1
    переместить_имм рдиай, 1
    переместить_имм рсиай, nl
    переместить_имм рдикс, 1
    вызов_системы
    
    ; exit(0)
    переместить_имм раикс, 60
    переместить_имм рдиай, 0
    вызов_системы

.данные
nl:
    .байт 0x0A

.бнд
цифра0:
    .резб 8
цифра1:
    .резб 8
цифра2:
    .резб 8
цифра3:
    .резб 8