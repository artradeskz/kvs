; тест_бнд_1.квс
; Полный цикл: запись → очистка → чтение из BSS

.текст
.глобал _start

_start:
    ; =============================================
    ; ТЕСТ 1: Абсолютная адресация в .бнд (полный цикл)
    ; =============================================
    
    ; 1. Записываем значение в BSS
    переместить_имм рдиай, 0x42
    сохранить [абс_перем], рдиай
    
    ; 2. Очищаем регистр (чтобы проверить, что значение реально из BSS)
    переместить_имм рдиай, 0x00
    
    ; 3. Загружаем значение обратно из BSS
    загрузить рдиай, [абс_перем]
    
    ; 4. Выход с кодом = значению из BSS
    переместить_имм раикс, 60
    вызов_системы

.данные
; Заглушка для pass5 (обязательна!)
пустые_данные: .байт 0

.бнд
абс_перем: .резб 1
_запас: .резб 4095  ; гарантирует, что BSS внутри страницы