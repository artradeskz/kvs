.текст
.глобал _start

_start:
    ; Получаем argv[1]
    вытолкнуть рсикс                 ; argc
    вытолкнуть рсиай                 ; argv[0]
    вытолкнуть р11                   ; argv[1] в R11

    ; Загружаем первый байт из argv[1] через R11
    загрузить ал, [р11]

    ; Сохраняем в переменную (не обязательно, но для проверки)
    сохранить [байт], ал

    ; Выход с кодом = загруженный байт
    переместить_имм раикс, 60
    загрузить рдиай, [байт]
    вызов_системы

.данные
байт: .байт 0