; тестирует косвенную адресацию через регистр
; не вылетел - значит работает (дополнительно проверить отладчиком)
; ./тесты/тест_адресации3.elf
; echo $?  # выведет 99

.текст
.глобал _start

_start:
    ; Загружаем адрес переменной в регистр RBX
    переместить_имм рбикс, переменная
    
    ; Запись значения 99 в переменную через косвенную адресацию
    переместить_имм раикс, 99
    сохранить [рбикс], раикс
    
    ; Завершение с кодом 99 (читаем из переменной через косвенную адресацию)
    переместить_имм раикс, 60
    загрузить рдиай, [рбикс]
    вызов_системы

.данные
переменная: .байт 0