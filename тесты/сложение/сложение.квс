; Тест операции сложения (прибавить)
; Результат должен быть 42

.текст
.глобал _start

_start:
    ; Загружаем первое число в регистр
    переместить_имм раикс, 40
    
    ; Загружаем второе число в другой регистр
    переместить_имм рбикс, 2
    
    ; Складываем: раикс = раикс + рбикс (40 + 2)
    прибавить раикс, рбикс
    
    ; Результат (42) теперь в RAX
    ; Перемещаем результат в RDI (первый аргумент для exit)
    переместить рдиай, раикс
    
    ; Системный вызов exit (код 60)
    переместить_имм раикс, 60
    вызов_системы

.данные
тестовая_переменная: .байт 0